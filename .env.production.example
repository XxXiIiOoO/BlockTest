# Copy to .env.production and replace every placeholder before deployment.
POSTGRES_USER=blocktest
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=blocktest
DATABASE_URL=postgresql+psycopg://blocktest:replace-with-a-long-random-password@postgres:5432/blocktest
REDIS_URL=redis://redis:6379/0

BLOCKTEST_ENV=production
BLOCKTEST_DEBUG=false
BLOCKTEST_AUTO_INIT_DB=false
BLOCKTEST_SCHEDULER_ENABLED=false
BLOCKTEST_SCHEDULER_TICK_SECONDS=60
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
BACKEND_CORS_ORIGINS=https://blocktest.example.com
FRONTEND_BASE_URL=https://blocktest.example.com
EXPOSE_VERIFICATION_TOKEN_IN_RESPONSE=false
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=noreply@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_2FA_ENABLED=false

DEFAULT_DOCKER_IMAGE=python:3.12-slim
DOCKER_ALLOWED_IMAGES=python:3.12-slim,node:20-bookworm-slim,blocktest-evm-presets:latest
DOCKER_RUN_TIMEOUT_SECONDS=300
DOCKER_MAX_OUTPUT_BYTES=1000000
DOCKER_MEMORY_LIMIT=512m
DOCKER_PIDS_LIMIT=128
DOCKER_NANO_CPUS=1000000000
DOCKER_READ_ONLY_ROOTFS=true
DOCKER_RUN_USER=1000:1000
DOCKER_NETWORK_DISABLED=true
DOCKER_RUNNER_NETWORK=blocktest_execution
DOCKER_RUNNER_NETWORK_ISOLATED=true
DOCKER_HOST=tcp://runner-daemon.example.internal:2376
DOCKER_TLS_VERIFY=1
DOCKER_CERT_PATH=/run/secrets/docker
DOCKER_CERTS_DIR=/absolute/path/to/runner-client-certs

BLOCKTEST_APP_NAME=BlockTest API
BLOCKTEST_SEED_PRESETS=false
BLOCKTEST_ADMIN_EMAIL=admin@example.com
BLOCKTEST_ADMIN_USERNAME=replace-with-admin-username
BLOCKTEST_ADMIN_PASSWORD=replace-with-a-unique-long-admin-password
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
VITE_API_URL=https://api.blocktest.example.com
